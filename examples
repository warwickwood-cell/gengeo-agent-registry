verify-store-example.js


const fetch = require("node-fetch");

async function verifyStore(domain) {
  try {
    const response = await fetch(
      `https://api.gengeo.co/api/verify?domain=${encodeURIComponent(domain)}`
    );

    const data = await response.json();

    console.log("GenGEO verification result:");
    console.log(JSON.stringify(data, null, 2));

    /*
      Example response:

      {
        "ok": true,
        "domain": "example.com",
        "verified": true,
        "status": "active",
        "eligible_for_ai_agent_purchase": "yes",
        "decision": "verified"
      }
    */

    if (
      data.verified === true &&
      data.status === "active"
    ) {
      console.log(
        "Merchant verification available. Continue with broader agent evaluation."
      );
    } else {
      console.log(
        "Verification unavailable or incomplete. Agent should use additional signals."
      );
    }

  } catch (err) {
    console.error("Verification lookup failed:", err.message);
  }
}

verifyStore("nike.com");
